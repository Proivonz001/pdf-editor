{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pdf-editor",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8771"],
      "port": 8771
    },
    {
      "name": "app-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "preview", "--port", "4173", "--strictPort"],
      "port": 4173,
      "cwd": "app"
    },
    {
      "name": "app-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port", "5173", "--strictPort"],
      "port": 5173,
      "cwd": "app"
    }
  ]
}
