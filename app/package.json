{
  "name": "pdf-editor-app",
  "private": true,
  "version": "0.1.0",
  "description": "PDF Editor, rewritten: MuPDF in a Web Worker, Preact UI, installable and offline.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "python -I scripts/make_icons.py"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "mupdf": "1.27.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  }
}
